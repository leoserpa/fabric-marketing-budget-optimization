			        "#70757A"
			    )
		displayFolder: Formatação
		lineageTag: 91a37138-fd37-4e9e-b668-3741b6ff9398

	measure '% Investimento' =
			
			DIVIDE(
			    [Investimento Total],
			    CALCULATE(
			        [Investimento Total],
			        REMOVEFILTERS('dim_objective')
			    )
			)
		displayFolder: Financeiro
		lineageTag: 790cbfd8-90eb-452f-9915-d5de94f89eab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Receita' =
			
			DIVIDE(
			    [Receita Total],
			    CALCULATE(
			        [Receita Total],
			        REMOVEFILTERS('dim_objective')
			    )
			)
		displayFolder: Financeiro
		lineageTag: e2676cb2-1ad7-4d36-996e-ef58a3d0a693

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gap Alocação' =
			
			[% Receita] - [% Investimento]
		displayFolder: Financeiro
		lineageTag: 0805b672-6ec1-4a1a-b52c-a09e01b6ea60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Gap Alocação' =
			
			VAR Gap = [Gap Alocação]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Gap), "#70757A",
			        Gap > 0.01, "#1D6FA5",
			        Gap < -0.01, "#70757A",
			        "#9AA0A6"
			    )
		displayFolder: Formatação
		lineageTag: 1178d38c-83cb-41da-9d65-11be0a8d253e

	measure '% Investimento por Campanha' =
			
			VAR InvestimentoCampanha =
			    [Investimento Total]
			
			VAR InvestimentoContexto =
			    CALCULATE(
			        [Investimento Total],
			        REMOVEFILTERS('fact_campaign_performance'[campaign_id]),
			        REMOVEFILTERS('fact_campaign_performance'[Status Orçamento]),
			        ALLSELECTED('dim_platform'[platform])
			    )
			
			RETURN
			    DIVIDE(
			        InvestimentoCampanha,
			        InvestimentoContexto,
			        BLANK()
			    )
		displayFolder: Financeiro
		lineageTag: 03f1c051-e954-4378-b8c8-e64b88854fb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
