table _Medidas
	lineageTag: 85b9a77a-e3d3-41d0-8c0f-9fa82949787b

	measure 'Investimento Total' =
			
			SUM('fact_campaign_performance'[ad_spend])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Financeiro
		lineageTag: 0fafc520-8e03-46a0-9290-2025636f7730

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Total' =
			
			SUM('fact_campaign_performance'[revenue])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Financeiro
		lineageTag: f098cd7a-065b-40b4-abc2-7b5860a1a474

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Lucro Total' =
			
			[Receita Total] - [Investimento Total]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4461cabc-0d55-4888-a6ba-ea2bb609432f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure ROAS =
			
			DIVIDE(
			    [Receita Total],
			    [Investimento Total],
			    BLANK()
			)
		formatString: #,0.00
		displayFolder: Performance
		lineageTag: 3d99920a-7d71-4dd2-801f-3c05366176ae

	measure 'Conversões Totais' =
			
			SUM('fact_campaign_performance'[conversions])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 2024b546-b372-4e52-9a4f-dc715c2b3634

	measure CPA =
			
			DIVIDE(
			    [Investimento Total],
			    [Conversões Totais],
			    BLANK()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Performance
		lineageTag: 4c744275-6078-4dcd-a1d9-36b341dff93e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Cliques Totais' =
			
			SUM('fact_campaign_performance'[clicks])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 508a1958-6d0a-45df-89b5-76c4e196f90b

	measure 'Impressões Totais' =
			
			SUM('fact_campaign_performance'[impressions])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 00006dfe-a475-4858-87a7-8c96af5c39dc

	measure CTR =
			
			DIVIDE(
			    [Cliques Totais],
			    [Impressões Totais],
			    0
			) * 100
		formatString: 0.00
		displayFolder: Performance
		lineageTag: ba844e56-b183-4f3e-9882-affd54d3927c

	measure 'Taxa de Conversão' =
			
			DIVIDE(
			    [Conversões Totais],
			    [Cliques Totais],
			    0
			) * 100
		formatString: 0.00
		displayFolder: Performance
		lineageTag: e23048d4-0c6d-44bb-bf9f-df184dd30c96

	measure CPC =
			
			DIVIDE(
			    [Investimento Total],
			    [Cliques Totais],
			    0
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Performance
		lineageTag: 5aa7c89e-2bc0-4fd8-b955-ebbf6cea747a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total de Campanhas' =
			
			DISTINCTCOUNT('fact_campaign_performance'[campaign_id])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 482c183b-42af-45e9-af8d-cdbf6d72c0e2

	measure 'Margem de Lucro' =
			
			DIVIDE(
			    [Lucro Total],
			    [Receita Total],
			    0
			) * 100
		formatString: 0.00
		displayFolder: Financeiro
		lineageTag: 82bbf16d-6dcc-4865-aae3-73c4b31faf60

	measure 'Cor ROAS Plataforma' =
			
			VAR ROASAtual = [ROAS]
			VAR MaiorROAS =
			    MAXX(
			        ALLSELECTED('dim_platform'[platform]),
			        CALCULATE([ROAS])
			    )
			RETURN
			    IF(
			        ROASAtual = MaiorROAS,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: baf3aae3-1850-45c7-b383-a21bc0090b7e

	measure 'Cor CPA Plataforma' =
			
			VAR CPAAtual = [CPA]
			VAR MenorCPA =
			    MINX(
			        ALLSELECTED('dim_platform'[platform]),
			        CALCULATE([CPA])
			    )
			RETURN
			    IF(
			        CPAAtual = MenorCPA,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: 6fb10c7a-58f1-427c-b7e5-cb9c7c7f53a9

	measure 'Cor Receita Eficiência' =
			
			VAR ROASPeriodo = [ROAS]
			VAR ROASGeral =
			    CALCULATE(
			        [ROAS],
			        ALLSELECTED('dim_date')
			    )
			RETURN
			    IF(
			        ROASPeriodo >= ROASGeral,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: 3ea90eb4-1d54-47b4-b222-db78fa7f4fe2

	measure 'Cor ROAS Objetivo' =
			
			VAR ROASAtual = [ROAS]
			VAR MaiorROAS =
			    MAXX(
			        ALLSELECTED('dim_objective'[campaign_objective]),
			        CALCULATE([ROAS])
			    )
			RETURN
			    IF(
			        ROASAtual = MaiorROAS,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: 0e7425ab-71bf-4a0b-9e30-434742cbf592

	measure 'Cor Investimento Plataforma' =
			
			VAR RankingAtual =
			    RANKX(
			        ALLSELECTED('dim_platform'[platform]),
			        CALCULATE([Investimento Total]),
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    SWITCH(
			        RankingAtual,
			        1, "#1D6FA5",   -- Azul
			        2, "#40454B",   -- Cinza bem escuro
			        3, "#5C6268",
			        4, "#787E84",
			        5, "#969BA0",
			        6, "#B8BCC0",   -- Cinza claro
			        "#B8BCC0"
			    )
		displayFolder: Formatação
		lineageTag: 05e4f350-b299-47dc-88d3-83d502943309

	measure 'Cor ROAS Dispositivo' =
			
			VAR ROASAtual = [ROAS]
			VAR MaiorROAS =
			    MAXX(
			        ALLSELECTED('dim_device'[device_type]),
			        CALCULATE([ROAS])
			    )
			RETURN
			    IF(
			        ROASAtual = MaiorROAS,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: eeec323f-1291-436a-8bda-0b79f0022bff

	measure 'Cor ROAS Posicionamento' =
			
			VAR ROASAtual = [ROAS]
			VAR MaiorROAS =
			    MAXX(
			        ALLSELECTED('dim_placement'[ad_placement]),
			        CALCULATE([ROAS])
			    )
			RETURN
			    IF(
			        ROASAtual = MaiorROAS,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: 0e551576-441a-4e98-b263-c88173d681e7

	measure 'Cor Conversão Criativo' =
			
			VAR ConversaoAtual = [Taxa de Conversão]
			VAR MaiorConversao =
			    MAXX(
			        ALLSELECTED('dim_creative'[creative_format]),
			        CALCULATE([Taxa de Conversão])
			    )
			RETURN
			    IF(
			        ConversaoAtual = MaiorConversao,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: 06063067-1cfa-4e7e-bccc-3764256624a8

	measure 'Cor ROAS Indústria' =
			
			VAR RankingAtual =
			    RANKX(
			        ALLSELECTED('dim_industry'[industry_vertical]),
			        CALCULATE([ROAS]),
			        ,
			        DESC,
			        DENSE
			    )
			
			RETURN
			    SWITCH(
			        RankingAtual,
			        1, "#1D6FA5",   -- Maior ROAS
			        2, "#4A4F54",
			        3, "#5D6267",
			        4, "#70757A",
			        5, "#858A8F",
			        6, "#9A9EA2",
			        "#9A9EA2"
			    )
		displayFolder: Formatação
		lineageTag: dba138fa-05ec-4472-9c98-7a5620884dbd

	measure 'Cor ROAS Tabela' =
			
			VAR ROASAtual = [ROAS]
			
			VAR CampanhasSelecionadas =
			    CALCULATETABLE(
			        VALUES('fact_campaign_performance'[campaign_id]),
			        ALLSELECTED('fact_campaign_performance')
			    )
			
			VAR TabelaROAS =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            CampanhasSelecionadas,
			            "@ROAS",
			                VAR CampanhaAtual =
			                    'fact_campaign_performance'[campaign_id]
			                RETURN
			                    CALCULATE(
			                        [ROAS],
			                        REMOVEFILTERS('fact_campaign_performance'),
			                        'fact_campaign_performance'[campaign_id] = CampanhaAtual
			                    )
			        ),
			        REMOVEFILTERS('dim_platform')
			    )
			
			VAR TabelaValida =
			    FILTER(
			        TabelaROAS,
			        NOT ISBLANK([@ROAS])
			    )
			
			VAR LimiteTop10 =
			    PERCENTILEX.INC(
			        TabelaValida,
			        [@ROAS],
			        0.90
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(ROASAtual)
			            && ROASAtual >= LimiteTop10,
			        "#1D6FA5",
			        "#FFFFFF"
			    )
		displayFolder: Formatação
		lineageTag: 3277b067-46fc-4a7b-954e-32e535c7e6df

	measure 'Cor CPA Tabela' =
			
			VAR CPAAtual = [CPA]
			
			VAR CampanhasValidas =
			    FILTER(
			        ALLSELECTED('fact_campaign_performance'[campaign_id]),
			        CALCULATE([CPA]) > 0
			            && NOT ISBLANK(CALCULATE([CPA]))
			    )
			
			VAR RankingCPA =
			    RANKX(
			        CampanhasValidas,
			        CALCULATE([CPA]),
			        ,
			        ASC,
			        DENSE
			    )
			
			VAR TotalCampanhasValidas =
			    COUNTROWS(CampanhasValidas)
			
			VAR LimiteTop10 =
			    MAX(
			        1,
			        ROUNDUP(TotalCampanhasValidas * 0.10, 0)
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(CPAAtual)
			            && CPAAtual > 0
			            && RankingCPA <= LimiteTop10,
			        "#1D6FA5",
			        "#FFFFFF"
			    )
		displayFolder: Formatação
		lineageTag: 028a56c7-33f2-4f2d-a31c-f3a680aac610

	measure 'Cor Investimento por ROAS' =
			
			VAR ROASAtual = [ROAS]
			
			VAR MaiorROAS =
			    MAXX(
			        ALLSELECTED('dim_platform'[platform]),
			        CALCULATE([ROAS])
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(ROASAtual) &&
			        ROASAtual = MaiorROAS,
			        "#1D6FA5",
			        "#5F6368"
			    )
		displayFolder: Formatação
		lineageTag: c8751991-4a99-4de2-85e1-d36046d76461

	measure 'Cor Status Orçamento' =
			
			VAR StatusAtual =
			    SELECTEDVALUE(
			        'fact_campaign_performance'[Status Orçamento]
			    )
			
			RETURN
			    SWITCH(
			        StatusAtual,
			        "Escalar", "#1D6FA5",
			        "Manter", "#70757A",
			        "Reavaliar", "#9AA0A6",
			        "#70757A"
			    )
		displayFolder: Formatação
		lineageTag: 8cd40b36-c158-40fc-ad5b-590500800e52

	measure 'Campanhas Totais' =
			
			DISTINCTCOUNT(
			    'fact_campaign_performance'[campaign_id]
			)
		formatString: 0
		displayFolder: Volume
		lineageTag: 51c44646-0cef-4f27-8d31-4dc82893f6d4

	measure 'Cor Investimento Reavaliar' =
			
			VAR InvestimentoAtual =
			    [Investimento Total]
			
			VAR MaiorInvestimento =
			    MAXX(
			        ALLSELECTED('dim_platform'[platform]),
			        CALCULATE([Investimento Total])
			    )
			
			RETURN
			    IF(
